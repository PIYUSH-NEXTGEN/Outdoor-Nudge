# Outdoor Nudge - example environment configuration
# Copy to ".env" and edit, or export these variables in your shell before running.
# Every value below is OPTIONAL: leaving it unset falls back to the default shown.

# --- Ollama (local LLM) ---
# Base URL of your local Ollama server.
OLLAMA_HOST=http://localhost:11434
# Default chat model used when a request does not specify one.
NUDGE_MODEL=gemma3:4b

# --- Weather / location (Open-Meteo) ---
# Latitude / longitude used to fetch local weather when a request omits lat/lon.
NUDGE_LAT=44.4268
NUDGE_LON=26.1025
# Seconds to wait for the Open-Meteo API before giving up.
NUDGE_WEATHER_TIMEOUT=12

# --- Paths (defaults resolve relative to the repo root) ---
# Where nudge history is persisted. NEVER commit this file - it holds private moods.
# NUDGE_HISTORY_FILE=data/history.json
# Front-end served at "/".
# NUDGE_INDEX_FILE=static/index.html
